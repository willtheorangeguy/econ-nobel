---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Bibliography from '../../components/Bibliography.astro';
import DownloadPanel from '../../components/DownloadPanel.astro';
import Status from '../../components/Status.astro';
import { works } from '../../lib/catalogue';
import { href } from '../../lib/links';
export async function getStaticPaths() { const articles=await getCollection('works');return works.map(work=>({params:{id:work.id},props:{work,article:articles.find(a=>a.id===work.id)!}})); }
const { work,article }=Astro.props;
const { Content,headings }=await render(article);
---
<BaseLayout title={work.title} description={article.data.abstract}><div class="award-grid" data-pagefind-body><header class="article-header"><p class="eyebrow">A foundational work · {work.year} · {work.work_type.replaceAll('-',' ')}</p><Status status={article.data.status}/><h1>{work.title}</h1><p class="byline">{work.authors.join(' · ')}</p><p>{work.journal_or_publisher}, {work.year}.</p>{work.doi&&<p class="small">DOI: <a href={`https://doi.org/${work.doi}`}>{work.doi}</a> <button class="copy-doi button" data-doi={work.doi}>Copy DOI</button><span class="small" role="status" data-copy-status></span></p>}</header><aside class="prize-sidebar" aria-label="Work sources and downloads" data-pagefind-ignore><DownloadPanel kind="works" id={work.id} status={article.data.status}/><section><h3>Read the original</h3>{work.versions.map(v=><div><p>{v.version_label}</p><a class="small" href={v.landing_page_url} target="_blank" rel="noopener noreferrer">Read original at {v.source_provider} ↗</a>{v.pdf_url&&<p><a class="small" href={v.pdf_url} target="_blank" rel="noopener noreferrer">Open PDF at provider ↗</a></p>}{v.epub_url&&<p><a class="small" href={v.epub_url} target="_blank" rel="noopener noreferrer">Open EPUB at provider ↗</a></p>}{v.local_pdf_path&&<p><a class="button" href={href(v.local_pdf_path)} download>Original PDF ↓</a></p>}{v.local_epub_path&&<p><a class="button" href={href(v.local_epub_path)} download>Original EPUB ↓</a></p>}<p class="rights-state">{v.allows_hosting?'Hosting permission recorded.':'External access only. Redistribution permission has not been established.'}<br/>{v.local_epub_path||v.epub_url?'':'Original EPUB unavailable: no verified, authorized edition or conversion.'}</p><small>Version/access checked {v.checked_at}. Provider access conditions may apply.</small></div>)}</section><section><h3>Award connections</h3>{work.award_links.map(l=><p><a href={href(`awards/${l.award_year}/`)}>{l.award_year} Economics Prize →</a></p>)}</section></aside><article class="reading-column">{article.data.status!=='published'&&<div class="editorial-banner" data-pagefind-ignore><strong>{article.data.status==='metadata-only'?'Work explanation in preparation':'Unreviewed work explanation'}</strong><p>Bibliographic metadata and the award connection are recorded below. This page is not counted as a finished, reviewed analysis.</p></div>}<section><h2>Why this work belongs here</h2>{work.award_links.map(l=><p>{l.why_linked} <span class="small">Classification: {l.classification}.</span></p>)}</section>{article.data.status!=='metadata-only'&&<div data-pagefind-ignore={article.data.status==='published'?undefined:true}><Content/></div>}{article.data.status==='metadata-only'&&<p>A detailed reading of this work has not yet been completed. We have not inferred its results from citation counts or its title.</p>}<Bibliography ids={[...new Set([...article.data.citation_ids,...work.source_citation_ids,...work.award_links.flatMap(l=>l.evidence_citation_ids)])]}/></article></div><script>
 document.querySelectorAll<HTMLButtonElement>('.copy-doi').forEach(button=>button.addEventListener('click',async()=>{const status=button.parentElement!.querySelector('[data-copy-status]')!;try{await navigator.clipboard.writeText(button.dataset.doi!);status.textContent=' DOI copied.';}catch{status.textContent=' Select the DOI link text to copy it.';}}));
</script></BaseLayout>

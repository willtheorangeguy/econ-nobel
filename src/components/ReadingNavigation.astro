---
interface Props { headings: { depth: number; slug: string; text: string }[]; }
const headings=Astro.props.headings.filter(h=>h.depth===2);
---
{headings.length>0&&<nav class="article-toc" aria-label="In this explanation" data-pagefind-ignore><h2>In this explanation</h2><ol>{headings.map(h=><li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></nav>}
<script>
 const toc=document.querySelector('.article-toc');
 if(toc&&'IntersectionObserver' in window){
  const links=[...toc.querySelectorAll<HTMLAnchorElement>('a')];
  const observer=new IntersectionObserver(entries=>{
   for(const entry of entries)if(entry.isIntersecting){for(const link of links){if(link.hash===`#${entry.target.id}`)link.setAttribute('aria-current','location');else link.removeAttribute('aria-current');}}
  },{rootMargin:'-5% 0px -65% 0px'});
  links.forEach(link=>{const section=document.getElementById(decodeURIComponent(link.hash.slice(1)));if(section)observer.observe(section);});
 }
</script>
